{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{REFERENCE_IMAGE}}"
    }
  },
  "2": {
    "class_type": "WanVideoModelLoader",
    "inputs": {
      "model": "REPLACE_WITH_YOUR_WAN2.2_TI2V_5B_CHECKPOINT.safetensors",
      "base_precision": "fp8_e4m3fn",
      "quantization": "disabled"
    }
  },
  "3": {
    "class_type": "WanVideoVAELoader",
    "inputs": {
      "model_name": "REPLACE_WITH_YOUR_WAN_VAE.safetensors"
    }
  },
  "4": {
    "class_type": "WanVideoTextEncode",
    "inputs": {
      "positive_prompt": "{{PROMPT}}",
      "negative_prompt": "{{NEGATIVE_PROMPT}}",
      "t5": ["2", 0]
    }
  },
  "5": {
    "class_type": "WanVideoImageToVideoEncode",
    "inputs": {
      "image": ["1", 0],
      "vae": ["3", 0],
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "num_frames": "{{FRAME_COUNT}}"
    }
  },
  "6": {
    "class_type": "WanVideoSampler",
    "inputs": {
      "model": ["2", 0],
      "text_embeds": ["4", 0],
      "image_embeds": ["5", 0],
      "seed": "{{SEED}}",
      "steps": 20,
      "cfg": 5.0,
      "scheduler": "unipc"
    }
  },
  "7": {
    "class_type": "WanVideoDecode",
    "inputs": {
      "samples": ["6", 0],
      "vae": ["3", 0]
    }
  },
  "8": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["7", 0],
      "frame_rate": 24,
      "filename_prefix": "ai_cartoon_studio_video",
      "format": "video/h264-mp4",
      "save_output": true
    }
  }
}
