# Copy this file to .env and adjust as needed. Never commit the real .env.

# SQLite by default. Point this at a PostgreSQL URL later without changing any
# application code - the ORM layer doesn't know or care which one it's using.
ACS_DATABASE_URL=sqlite:///../data/db.sqlite3

# Origins allowed to call this API (the frontend's dev server, typically).
ACS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

ACS_ENVIRONMENT=development

# --- LLM story pipeline (Phase 3) ---
# "mock" (default - zero cost, zero setup, deterministic) | "anthropic" | "openai_compatible"
# openai_compatible also covers local Ollama/vLLM: set OPENAI_BASE_URL to e.g.
# http://localhost:11434/v1 and leave OPENAI_API_KEY unset.
ACS_LLM_CREATIVE_PROVIDER=mock
# ACS_LLM_CREATIVE_MODEL=claude-sonnet-5
ACS_LLM_MECHANICAL_PROVIDER=mock
# ACS_LLM_MECHANICAL_MODEL=claude-sonnet-5

# --- Storyboard image generation (Phase 4) ---
# "mock" (default - zero cost, zero setup, draws a real placeholder PNG) |
# "comfyui" (self-hosted) | "fal" (hosted fal-ai/flux/schnell - needs FAL_KEY)
ACS_IMAGE_PROVIDER=mock
# ACS_COMFYUI_BASE_URL=http://127.0.0.1:8188

# --- Voice generation (Phase 5) ---
# "mock" (default - zero cost, zero setup, writes a real placeholder WAV tone) |
# "openai_compatible" (self-hosted Chatterbox/CosyVoice2/Qwen3-TTS servers that
# expose an OpenAI-style /audio/speech endpoint: set TTS_BASE_URL to e.g.
# http://localhost:8880/v1 and leave TTS_API_KEY unset for local servers that
# don't check it - deliberately separate from OPENAI_BASE_URL below so the
# story pipeline and the voice pipeline can point at two different servers) |
# "fal" (hosted fal-ai/chatterbox/text-to-speech - needs FAL_KEY; every
# character currently gets the same default voice - see FalVoiceProvider's
# docstring)
ACS_VOICE_PROVIDER=mock
# ACS_VOICE_MODEL=tts-1

# --- Video generation (Phase 6) ---
# "mock" (default - zero cost, zero setup, animates the reference image into
# a real placeholder GIF) | "comfyui" (self-hosted Wan2.2-TI2V-5B, reuses
# ACS_COMFYUI_BASE_URL above) | "fal" (hosted fal-ai/wan/v2.2-5b/image-to-video -
# needs FAL_KEY, costs real money per call: ~$0.06/video-second)
ACS_VIDEO_PROVIDER=mock

# --- Lip-sync (Phase 9 pilot production) ---
# "mock" (default - zero cost, zero setup, returns the shot's video
# untouched) | "fal" (hosted MuseTalk by default, or LatentSync in quality
# mode - needs FAL_KEY, run as its own pass after a shot's video already
# exists and is approved)
ACS_LIPSYNC_PROVIDER=mock
ACS_LIPSYNC_QUALITY_MODE=false

# --- Provider credentials ---
# Read directly by the relevant SDK (its own convention, not this app's ACS_ prefix)
# so real keys never get invented ad hoc later. Set only what you actually use.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# TTS_API_KEY=
# TTS_BASE_URL=
# FAL_KEY=
